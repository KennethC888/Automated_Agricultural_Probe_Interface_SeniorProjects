Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: FarmGrid
      Enabled: true
      Plane: XY
      Cell Size: 1.0
      Plane Cell Count: 100
      Color: 100; 100; 100
      Alpha: 0.5
      Offset:
        X: 50.0
        Y: 50.0
        Z: 0.0
    - Class: rviz_default_plugins/MarkerArray
      Name: FarmMarkers
      Enabled: true
      Topic:
        Value: /farm/markers
    - Class: rviz_default_plugins/MarkerArray
      Name: RoverMarkers
      Enabled: true
      Topic:
        Value: /rover/markers
  Global Options:
    Fixed Frame: map
    Frame Rate: 30
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 135.0
      Focal Point:
        X: 50.0
        Y: 50.0
        Z: 0.0
      Pitch: 1.15
      Yaw: 0.0
      Target Frame: map
